PORT=2567
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated browser origins allowed by CORS.
# Supports "*.vercel.app" / "https://*.vercel.app" for preview deployments.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://gotchiverse-2d.vercel.app,https://*.vercel.app

# JWT for wallet auth / Colyseus onAuth
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=86400

# Public URL clients use for HTTP + Colyseus (no trailing slash)
PUBLIC_URL=http://localhost:2567

# Base Envio via Aarcade proxy (no Goldsky fallback)
CORE_SUBGRAPH_URL=https://aarcadeghst.com/api/subgraph/aavegotchi-core-base
GOTCHIVERSE_SUBGRAPH_URL=https://aarcadeghst.com/api/subgraph/gotchiverse-base

# When true, skip subgraph ownership check (local sandbox only)
SKIP_OWNERSHIP_CHECK=true

# Flip true after AarenaRoom join is verified in prod
COMBAT_IS_LIVE=false
