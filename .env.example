PORT=2567
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated browser origins allowed by CORS.
# Supports "*.vercel.app" / "https://*.vercel.app" for preview deployments.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://gotchiverse-2d.vercel.app,https://*.vercel.app

# JWT for wallet auth / Colyseus onAuth
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=86400

# Public URL clients use for HTTP + Colyseus (no trailing slash)
PUBLIC_URL=http://localhost:2567

# Base Envio via Aarcade proxy (no Goldsky fallback)
CORE_SUBGRAPH_URL=https://aarcadeghst.com/api/subgraph/aavegotchi-core-base
GOTCHIVERSE_SUBGRAPH_URL=https://aarcadeghst.com/api/subgraph/gotchiverse-base

# When true, skip subgraph ownership check (local sandbox only)
SKIP_OWNERSHIP_CHECK=true

# Flip true after AarenaRoom join is verified in prod
COMBAT_IS_LIVE=false

# Agent as Player (aCartridge) — AarcadeGh-t docs/ACARTRIDGE_DIAMOND_PLAN.md
# Base URL of the Aarcade aCartridge API (agent auth lookup + attested checkpoints)
AARCADE_ACARTRIDGE_URL=https://aarcadeghst.com/api/acartridge
# Attestor key (matches ACARTRIDGE_ATTESTOR_SECRET on Aarcade). Empty = agents play but sessions are not attested.
ACARTRIDGE_ATTESTOR_SECRET=
# Cartridge gameId agents enter for this realm
ACARTRIDGE_GAME_ID=gotchiverse-base
# Chain mode (Phase 2): sign EIP-712 checkpoints for the aCartridge diamond. Key from
# `abra keygen foundry Gotchiverse-Server` (EVM_PRIVATE_KEY) — register its address with setAttestor.
# ACARTRIDGE_DIAMOND=0x8fB6DD5Cef4521E01cCAb178B84eE1392CdB1232
# ACARTRIDGE_CHAIN_ID=84532
# ACARTRIDGE_ATTESTOR_PRIVATE_KEY=
