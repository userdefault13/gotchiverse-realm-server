{
  "name": "gotchiverse-realm-server",
  "version": "0.1.0",
  "private": true,
  "description": "Colyseus REALM server + HTTP BFF for Gotchiverse 2D walkable MVP",
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:all": "bash scripts/dev-all.sh",
    "build": "tsc",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.37",
    "@colyseus/ws-transport": "^0.15.3",
    "colyseus": "^0.15.57",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
